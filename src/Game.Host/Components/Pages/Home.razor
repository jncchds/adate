@page "/"
@using Game.Core.Saves
@using Game.Core.Settings
@using Game.Data.Repositories
@inject SaveRepository Saves
@inject ISettingCatalog Settings
@rendermode InteractiveServer

<PageTitle>adate</PageTitle>

<h1>adate</h1>

@if (_error is not null)
{
    <p class="error-text">@_error</p>
}

@if (_saves.Count > 0)
{
    <h2>Continue</h2>
    <div class="save-list">
        @foreach (var (save, setting) in _saves)
        {
            <a class="choice" href="/play/@save.Id.Value">
                <strong>@(setting ?? "No setting yet")</strong>
                <small>started @save.CreatedUtc.ToLocalTime().ToString("g")</small>
            </a>
        }
    </div>
}

<h2>New game</h2>
<p class="lede">Choose where the story happens, tell it who you are, and describe the person you will meet.</p>
<a class="button accent" href="/new">Start a new story</a>

@code {
    private IReadOnlyList<(SaveRecord Save, string? Setting)> _saves = [];
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var saves = new List<(SaveRecord, string?)>();
            foreach (var save in await Saves.ListAsync())
            {
                var settingId = await Saves.GetSettingIdAsync(save.Id);
                var setting = settingId is null ? null : Settings.All().FirstOrDefault(s => s.Id == settingId)?.DisplayName;
                saves.Add((save, setting));
            }

            _saves = saves;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
