@page "/"
@using Game.Core
@using Game.Core.Characters
@using Game.Core.Saves
@using Game.Core.Style
@using Game.Data.Repositories
@using Game.Host.Services
@inject SaveRepository Saves
@inject CharacterRepository Characters
@inject CharacterStudio Studio
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>New character</PageTitle>

<h1>Describe a character</h1>

<p class="lede">
    These attributes are the contract the generated art is judged against. The first portrait
    shows exactly what you choose here. The others each move one or two of hair colour, hair
    style and eye colour to a close neighbour, and whichever portrait you pick becomes the
    character.
</p>

<EditForm Model="@_form" OnValidSubmit="@CreateAsync" FormName="appearance">
    <DataAnnotationsValidator />

    <div class="grid">
        <label>
            Love interest
            <InputSelect @bind-Value="_form.Subject" @bind-Value:after="ApplySubjectChoices">
                @foreach (var subject in _subjects)
                {
                    <option value="@subject">@subject</option>
                }
            </InputSelect>
            <small>Resolved against the style pack's subject anchors. The tokens that read as
                an adult man are not the ones that read as an adult woman, so this is a
                declared attribute rather than something inferred from the others.</small>
        </label>

        <label>
            Age
            <InputNumber @bind-Value="_form.Age" min="18" max="99" />
            <small>Adults only. Never varied between portraits: it is what the content rules
                are computed from.</small>
        </label>

        <label>
            Hair colour
            <InputSelect @bind-Value="_form.HairColor">
                @foreach (var tag in Choices(AppearanceFeatures.HairColor))
                {
                    <option value="@tag">@tag</option>
                }
            </InputSelect>
            <small>Alternatives may offer a close shade.</small>
        </label>

        <label>
            Hair style
            <InputSelect @bind-Value="_form.HairStyle">
                @foreach (var tag in Choices(AppearanceFeatures.HairStyle))
                {
                    <option value="@tag">@tag</option>
                }
            </InputSelect>
            <small>Alternatives may offer a nearby style.</small>
        </label>

        <label>
            Eye colour
            <InputSelect @bind-Value="_form.EyeColor">
                @foreach (var tag in Choices(AppearanceFeatures.EyeColor))
                {
                    <option value="@tag">@tag</option>
                }
            </InputSelect>
            <small>Alternatives may offer a close shade.</small>
        </label>

        <label>
            Skin tone
            <InputSelect @bind-Value="_form.SkinTone">
                @foreach (var tag in Choices(AppearanceFeatures.SkinTone))
                {
                    <option value="@tag">@tag</option>
                }
            </InputSelect>
            <small>Kept exactly as chosen.</small>
        </label>

        <label>
            Build
            <InputSelect @bind-Value="_form.Build">
                @foreach (var tag in Choices(AppearanceFeatures.Build))
                {
                    <option value="@tag">@tag</option>
                }
            </InputSelect>
            <small>Kept exactly as chosen. Words like "slim" and "petite" are not offered:
                tag-based checkpoints read them as juvenile.</small>
        </label>

        <label>
            Height
            <InputSelect @bind-Value="_form.Height">
                @foreach (var tag in Choices(AppearanceFeatures.Height))
                {
                    <option value="@tag">@tag</option>
                }
            </InputSelect>
            <small>Kept exactly as chosen.</small>
        </label>

        <label>
            Distinguishing feature
            <InputText @bind-Value="_form.DistinguishingFeature" placeholder="freckles" />
            <small>Optional, and kept exactly as written.</small>
        </label>
    </div>

    <ValidationSummary />

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }

    <button type="submit" disabled="@_working">
        @(_working ? "Creating…" : $"Generate {Studio.CandidateCount} portraits")
    </button>
</EditForm>

@code {
    private readonly AppearanceForm _form = new();
    private bool _working;
    private string? _error;
    private StylePack? _pack;

    // The pack decides which subjects exist, so the choice cannot be a hardcoded list here.
    private IReadOnlyList<string> _subjects = ["female"];

    protected override async Task OnInitializedAsync()
    {
        _pack = await Studio.GetPackAsync();
        _subjects = [.. _pack.Subjects.Keys.Order(StringComparer.Ordinal)];
        _form.Subject = _subjects[0];
        ApplySubjectChoices();
    }

    private IReadOnlyList<string> Choices(string feature) =>
        _pack is null ? [] : [.. _pack.SubjectFor(_form.Subject).OptionsFor(feature).Select(o => o.Tag)];

    /// <summary>
    /// Choices are per subject, so switching subject can leave a value the new one does not
    /// offer. Each current value is kept when it is still on offer and otherwise replaced by the
    /// new subject's first choice, so the form never submits something the pack cannot vary.
    /// </summary>
    private void ApplySubjectChoices()
    {
        _form.HairColor = Keep(AppearanceFeatures.HairColor, _form.HairColor);
        _form.HairStyle = Keep(AppearanceFeatures.HairStyle, _form.HairStyle);
        _form.EyeColor = Keep(AppearanceFeatures.EyeColor, _form.EyeColor);
        _form.SkinTone = Keep(AppearanceFeatures.SkinTone, _form.SkinTone);
        _form.Build = Keep(AppearanceFeatures.Build, _form.Build);
        _form.Height = Keep(AppearanceFeatures.Height, _form.Height);
    }

    private string Keep(string feature, string current)
    {
        var choices = Choices(feature);

        if (choices.Contains(current, StringComparer.OrdinalIgnoreCase))
        {
            return current;
        }

        return choices.Count > 0 ? choices[0] : current;
    }

    private async Task CreateAsync()
    {
        _working = true;
        _error = null;

        try
        {
            var appearance = _form.ToAppearance();

            // Validated here so a bad value is reported against the field the player typed
            // it into, rather than surfacing later as a CHECK constraint or a bad prompt.
            appearance.Validate();

            // Spike 0 has exactly one save, but it is created and referenced explicitly:
            // every table carries save_id from day one (HANDOFF 1.4).
            var save = await Saves.CreateAsync(
                Studio.StylePackId,
                Studio.PackFingerprint(),
                Ceiling.PG13);

            var character = await Characters.CreateAsync(save.Id, appearance);

            Navigation.NavigateTo($"/candidates/{character.Id}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _working = false;
        }
    }

    private sealed class AppearanceForm
    {
        public string Subject { get; set; } = "female";
        public int Age { get; set; } = 24;
        public string HairColor { get; set; } = "red hair";
        public string HairStyle { get; set; } = "long hair";
        public string EyeColor { get; set; } = "green eyes";
        public string SkinTone { get; set; } = "pale skin";
        public string Build { get; set; } = "average build";
        public string Height { get; set; } = "average height";
        public string DistinguishingFeature { get; set; } = "freckles";

        public CharacterAppearance ToAppearance() => new(
            Subject, Age, EyeColor, HairColor, HairStyle, SkinTone, Build, Height, DistinguishingFeature);
    }
}
