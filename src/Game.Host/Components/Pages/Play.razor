@page "/play/{SaveGuid:guid}"
@using Game.Core.Content
@using Game.Core.Encounters
@using Game.Core.Places
@using Game.Core.Saves
@using Game.Core.Story
@using Game.Play
@inject WorldService World
@inject CharacterStudio Studio
@inject ILocationCatalog PlaceTypes
@inject IJSRuntime JS
@rendermode InteractiveServer

@*
    The same screen as the desktop and phone app (Game.App PlayView): the picture always fills the stage, the
    person stands at the left, and the words scroll in a translucent box over the lower part of the rest. On an
    upright screen the picture takes the top and the words sit below. Scenes are saved as they happen, so
    coming back shows the same one.
*@

<PageTitle>@_heading</PageTitle>

<div class="play">
    <div class="play-area @(_mode == Mode.Scene ? null : "tall") @(_isPhone ? "phone" : null)">
        <div class="play-stage">
            @if (_stageBackground is not null)
            {
                <img class="play-background" src="@_stageBackground" alt="" />
            }

            @* On the map: everyone met so far, standing left to right on the backdrop, one slot per person. *@
            @if (_mode == Mode.Map && _lineup.Count > 0)
            {
                <div class="lineup" style="grid-template-columns: repeat(@_lineup.Count, minmax(0, 1fr))">
                    @foreach (var slot in _lineup)
                    {
                        <div class="lineup-slot">
                            <div class="sprite-frame">
                                @if (slot.Portrait is not null)
                                {
                                    <img src="@slot.Portrait" alt="@slot.Name" />
                                }
                            </div>
                            @if (slot.IsMet && slot.Portrait is null)
                            {
                                <span class="spinner small centered" aria-hidden="true"></span>
                            }
                            @if (slot.IsMet)
                            {
                                <span class="lineup-name">@slot.Name</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <div class="play-figure">
            <div class="sprite-frame">
                @if (_stageSprite is not null)
                {
                    <img src="@_stageSprite" alt="@_speaker" />
                }
            </div>
            @if (_stageBackground is null && _mode != Mode.Error)
            {
                <div class="loading" role="status">
                    <span class="spinner" aria-hidden="true"></span>
                    <p>@_stageLoadingText</p>
                </div>
            }
        </div>

        <section class="play-textbox">
            <header class="textbox-header">
                @* Ten quick taps on the title open the debug screen. *@
                <h1 class="title" @onclick="TitleTapped">@_heading</h1>
                @if (!string.IsNullOrEmpty(_speaker))
                {
                    <span class="nametag">@_speaker</span>
                }
            </header>

            <div class="side" @ref="_side">
                @switch (_mode)
                {
                    case Mode.Loading:
                        <div class="writing"><span class="spinner small" aria-hidden="true"></span><span class="lede">Loading the save…</span></div>
                        break;

                    case Mode.Error:
                        <p class="error-text">@_error</p>
                        <button type="button" class="accent" @onclick="RetryAsync">Try again</button>
                        break;

                    case Mode.Scene:
                        @if (!string.IsNullOrEmpty(_sceneText))
                        {
                            <p class="story">@_sceneText</p>
                        }
                        @if (_withLine is not null)
                        {
                            <p class="small">@_withLine</p>
                        }
                        @if (_revealLine is not null)
                        {
                            <p class="small">@_revealLine</p>
                        }
                        @if (_noteLine is not null)
                        {
                            <p class="note">@_noteLine</p>
                        }

                        @foreach (var exchange in _exchanges)
                        {
                            <div class="exchange">
                                <div class="reply">
                                    <span class="small">You</span>
                                    <p class="story">@exchange.Reply</p>
                                </div>
                                @if (exchange.Reaction is not null)
                                {
                                    <p class="story reaction">@exchange.Reaction</p>
                                }
                                @if (exchange.Popup is not null)
                                {
                                    <div class="popup" role="status">@exchange.Popup</div>
                                }
                                @if (exchange.Agreed is not null)
                                {
                                    <p class="note">@exchange.Agreed</p>
                                }
                            </div>
                        }

                        @if (_isWriting)
                        {
                            <div class="writing"><span class="spinner small" aria-hidden="true"></span><span class="lede">@_writingText</span></div>
                        }

                        @foreach (var choice in _choices)
                        {
                            <button type="button" class="choice" disabled="@_working" @onclick="() => PickChoiceAsync(choice)">@choice.Text</button>
                        }

                        @if (_canReply)
                        {
                            <form class="reply-form" @onsubmit="ReplyAsync">
                                <input type="text" @bind="_reply" @bind:event="oninput" maxlength="300" placeholder="Or say or do something else…" disabled="@_working" />
                                <button type="submit" disabled="@(_working || string.IsNullOrWhiteSpace(_reply))">Reply</button>
                            </form>
                        }

                        @if (_showContinue)
                        {
                            <button type="button" class="accent" disabled="@_working" @onclick="ContinueAsync">Continue</button>
                        }

                        @* Once the conversation is over, texting someone from here before moving on. *@
                        @if (_contacts.Count > 0)
                        {
                            <p class="small">Or text someone from here</p>
                            <div class="chips">
                                @foreach (var contact in _contacts)
                                {
                                    <button type="button" class="chip" disabled="@_working" @onclick="() => TextAsync(contact)">Text @contact.Name</button>
                                }
                            </div>
                        }
                        break;

                    case Mode.Map:
                        <p class="lede">@_lede</p>
                        @foreach (var note in _notes)
                        {
                            <p class="note">@note</p>
                        }

                        @if (_people.Count > 0)
                        {
                            <h2>Bring someone along</h2>
                            <div class="person-cards">
                                @foreach (var card in _people)
                                {
                                    @PersonCard(card)
                                }
                            </div>
                        }

                        <h2>Where to</h2>
                        <div class="place-cards">
                            @foreach (var card in _places)
                            {
                                <button type="button" class="card place-card" disabled="@_working" @onclick="() => GoAsync(card)">
                                    <span class="place-picture">
                                        @if (card.Thumbnail is not null)
                                        {
                                            <img src="@card.Thumbnail" alt="" />
                                        }
                                        else
                                        {
                                            <span class="spinner small centered" aria-hidden="true"></span>
                                        }
                                    </span>
                                    <span class="place-name">@card.Place.Name</span>
                                    <small>@card.TypeName</small>
                                </button>
                            }
                        </div>
                        break;

                    case Mode.EndingOffer:
                        @foreach (var note in _notes)
                        {
                            <p class="note">@note</p>
                        }
                        <p class="lede">@_lede</p>
                        <div class="person-cards">
                            @foreach (var card in _people)
                            {
                                @PersonCard(card)
                            }
                        </div>
                        break;

                    case Mode.Ending when _state?.Ending is { } ending:
                        <p class="story">@ending.Text</p>

                        @if (ending.Departures.Count > 0)
                        {
                            <h2>Who walked away</h2>
                            @foreach (var departure in ending.Departures)
                            {
                                <p class="note">@departure</p>
                            }
                        }

                        @if (ending.PassedOver.Count > 0)
                        {
                            <h2>Who you passed over</h2>
                            <p class="lede">@string.Join(", ", ending.PassedOver)</p>
                        }

                        @if (ending.Choices is { Count: > 0 } madeChoices)
                        {
                            <h2>Your choices</h2>
                            @foreach (var line in madeChoices)
                            {
                                <div class="recap-line">
                                    <span class="small">Day @line.Day, @line.Slot.ToLowerInvariant()</span>
                                    <span>“@line.Words”</span>
                                    <span class="note">@string.Join(" · ", line.Influence)</span>
                                </div>
                            }
                        }

                        @if (ending.ProfileOf is not null)
                        {
                            <h2>@ending.ProfileOf</h2>
                            @foreach (var line in ending.Profile)
                            {
                                <p class="lede">@line</p>
                            }
                        }

                        <a class="button accent" href="/">Start another story</a>
                        break;

                    case Mode.NoOpening:
                        <p class="lede">@_lede</p>
                        <a class="button accent" href="/opening/@SaveGuid">Choose an opening</a>
                        break;

                    case Mode.Over:
                        <p class="lede">@_lede</p>
                        break;
                }
            </div>
        </section>

        @* A conversation by text: a phone over the place the player is at, blurred behind it, and nobody standing there. *@
        @if (_isPhone && _mode == Mode.Scene)
        {
            <section class="phone" aria-label="Messages">
                <header class="phone-header">
                    <span class="avatar" style="@(_phonePortrait is null ? null : $"background-image: url('{_phonePortrait}')")"></span>
                    <span class="phone-who">
                        <strong>@_speaker</strong>
                        <span class="small">@_heading</span>
                    </span>
                </header>

                <div class="thread" @ref="_thread">
                    @foreach (var message in _messages)
                    {
                        <p class="bubble @(message.Mine ? "mine" : null) @(message.Note ? "note" : null)">@message.Text</p>
                    }
                    @if (_isWriting)
                    {
                        <div class="writing"><span class="spinner small" aria-hidden="true"></span><span class="lede">@_writingText</span></div>
                    }
                </div>

                <div class="phone-keys">
                    @foreach (var choice in _choices)
                    {
                        <button type="button" class="choice" disabled="@_working" @onclick="() => PickChoiceAsync(choice)">@choice.Text</button>
                    }
                    @if (_canReply)
                    {
                        <form class="reply-form" @onsubmit="ReplyAsync">
                            <input type="text" @bind="_reply" @bind:event="oninput" maxlength="300" placeholder="Message…" disabled="@_working" />
                            <button type="submit" disabled="@(_working || string.IsNullOrWhiteSpace(_reply))">Send</button>
                        </form>
                    }
                    @if (_showContinue)
                    {
                        <button type="button" class="accent" disabled="@_working" @onclick="ContinueAsync">Put the phone away</button>
                    }
                </div>
            </section>
        }

        @* Overlays, above the person: back to the saves, the place's name, and the busy line. *@
        <a class="back" href="/" title="Saves" aria-label="Saves">‹</a>
        @if (!string.IsNullOrEmpty(_caption))
        {
            <div class="caption">@_caption</div>
        }
        @if (_working)
        {
            <div class="busy" role="progressbar" aria-label="Working"></div>
        }

        @* The hidden debug screen, over everything. *@
        @if (_debugOpen)
        {
            <div class="debug">
                <div class="debug-bar">
                    <strong class="title">Debug</strong>
                    <button type="button" @onclick="OpenDebugAsync">Refresh</button>
                    <button type="button" @onclick="() => _debugOpen = false">Close</button>
                </div>
                <div class="debug-body">
                    @foreach (var part in _debugSections)
                    {
                        <details open>
                            <summary>@part.Title</summary>
                            <pre>@(part.Lines.Count == 0 ? "(none)" : string.Join('\n', part.Lines))</pre>
                        </details>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private enum Mode
    {
        Loading,
        Error,
        Scene,
        Map,
        EndingOffer,
        Ending,
        NoOpening,
        Over,
    }

    [Parameter]
    public Guid SaveGuid { get; set; }

    /// <summary>An opening's meeting place, to go straight into instead of showing the map.</summary>
    [SupplyParameterFromQuery]
    public string? Start { get; set; }

    private SaveId SaveId => new(SaveGuid);

    private ElementReference _side;
    private string? _scrollRequest;

    private PlayState? _state;
    private TurnOutcome? _outcome;
    private SceneView? _view;
    private string _invite = "";

    // Where the player was last, so the stage shows them there.
    private PlaceRecord? _stagePlace;

    // Bumped whenever the scene on screen changes, so a picture or answer for an earlier one is dropped.
    private int _scene;
    private int _generation;

    private Mode _mode = Mode.Loading;
    private bool _working;
    private string? _error;
    private string _heading = "Play";
    private string? _lede;
    private string? _caption;
    private string? _stageBackground;
    private string _stageLoadingText = "Opening the save…";
    private string? _stageSprite;
    private string? _sceneText;
    private string? _speaker;
    private bool _isWriting;
    private string _writingText = "Writing the scene…";
    private string? _withLine;
    private string? _revealLine;
    private string? _noteLine;
    private readonly List<Exchange> _exchanges = [];
    private IReadOnlyList<ChoiceButton> _choices = [];
    private bool _canReply;
    private bool _showContinue;
    private string _reply = "";
    private IReadOnlyList<string> _notes = [];
    private readonly List<PersonCardItem> _people = [];
    private readonly List<PlaceCardItem> _places = [];
    private readonly List<LineupSlot> _lineup = [];
    private IReadOnlyList<Invitee> _contacts = [];

    // A conversation by text: a phone over the blurred place instead of the person and the text box.
    private bool _isPhone;
    private string? _phonePortrait;
    private IReadOnlyList<Message> _messages = [];
    private ElementReference _thread;

    private bool _debugOpen;
    private IReadOnlyList<DebugSection> _debugSections = [];
    private readonly Queue<DateTime> _taps = new();

    // Pictures, reused while the slot and weather they were drawn for last.
    private readonly Dictionary<string, string> _thumbnails = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _portraits = new(StringComparer.Ordinal);
    private string? _picturesFor;
    private string? _backdrop;

    private sealed class Exchange(string reply)
    {
        public string Reply { get; } = reply;

        public string? Reaction { get; set; }

        public string? Popup { get; set; }

        public string? Agreed { get; set; }
    }

    /// <summary>One bubble of a conversation by text: theirs, the player's own, or a note on what came of it.</summary>
    private sealed record Message(string Text, bool Mine, bool Note);

    /// <summary>An encounter's own choice, or a proposed reply by its index.</summary>
    private sealed record ChoiceButton(string Text, EncounterChoice? Authored, int? Index);

    private sealed class PersonCardItem(string key, string label, bool isNobody)
    {
        public string Key { get; } = key;

        public string Label { get; } = label;

        public bool IsNobody { get; } = isNobody;

        public bool Chosen { get; set; }

        public string? Portrait { get; set; }
    }

    private sealed class PlaceCardItem(PlaceRecord place, string typeName)
    {
        public PlaceRecord Place { get; } = place;

        public string TypeName { get; } = typeName;

        public string? Thumbnail { get; set; }
    }

    private sealed class LineupSlot(string key, string name, bool isMet)
    {
        public string Key { get; } = key;

        public string Name { get; } = name;

        public bool IsMet { get; } = isMet;

        public string? Portrait { get; set; }
    }

    private RenderFragment PersonCard(PersonCardItem card) => __builder =>
    {
        <button type="button" class="card person-card @(card.Chosen ? "chosen" : null)" disabled="@_working" @onclick="() => PersonPickedAsync(card)">
            <span class="person-picture" style="@(card.IsNobody || _backdrop is null ? null : $"background-image: url('{_backdrop}')")">
                @if (card.IsNobody)
                {
                    <span class="person-none">—</span>
                }
                else
                {
                    <span class="sprite-frame">
                        @if (card.Portrait is not null)
                        {
                            <img src="@card.Portrait" alt="" />
                        }
                    </span>
                    @if (card.Portrait is null)
                    {
                        <span class="spinner small centered" aria-hidden="true"></span>
                    }
                }
            </span>
            <span class="person-name">@card.Label</span>
        </button>
    };

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();

        // Choosing an opening leads straight into its meeting, not to a map with a hint.
        if (Start is { } start && _mode == Mode.Map && _places.FirstOrDefault(p => p.Place.Id == start) is { } card)
        {
            await GoAsync(card);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollRequest is { } request)
        {
            _scrollRequest = null;
            try
            {
                await JS.InvokeVoidAsync(request, _isPhone && _mode == Mode.Scene ? _thread : _side);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or TaskCanceledException)
            {
                // Scrolling is a nicety; a page that is going away does not need it.
            }
        }
    }

    private Task RefreshAsync() => InvokeAsync(StateHasChanged);

    private async Task ReloadAsync()
    {
        _error = null;

        try
        {
            var state = await World.GetPlayStateAsync(SaveId);
            _state = state;
            Apply(state);

            if (state.Scene is { } scene)
            {
                _ = RestoreSceneAsync(scene);
            }
            else
            {
                _ = LoadPicturesAsync(state);
            }
        }
        catch (Exception ex)
        {
            ShowError(ex);
        }
    }

    /// <summary>Shows the save as it stands, in the same order of precedence as the app.</summary>
    private void Apply(PlayState state)
    {
        _scene++;
        _outcome = null;
        _view = null;
        _exchanges.Clear();
        _isWriting = false;
        _reply = "";
        _withLine = null;
        _revealLine = null;
        _noteLine = null;
        _stageSprite = null;
        _speaker = null;
        _people.Clear();
        _places.Clear();
        _lineup.Clear();
        _contacts = [];
        _notes = [];
        _isPhone = false;
        _phonePortrait = null;

        if (state.Scene is { } scene)
        {
            ShowStoredScene(state, scene);
        }
        else if (state.PendingScene is { } waiting)
        {
            _heading = $"Day {waiting.Clock.Day}, {waiting.Clock.Slot}";
            _sceneText = waiting.Text;
            _view = new SceneView(waiting.Text, null, null, null, null, waiting.Choices) { Open = true };
            _mode = Mode.Scene;
        }
        else if (state.Ending is { } ending)
        {
            _heading = ending.PartnerName is null ? "On your own" : $"With {ending.PartnerName}";
            _caption = null;
            _stageLoadingText = "Setting the scene…";
            _mode = Mode.Ending;
        }
        else if (state.EndingOffer is { } offer)
        {
            _heading = state.Over ? $"The {state.Setting.Days} days are over" : "It is time to decide";
            _notes = offer.Departures;
            _lede = offer.Routes.Count == 0
                ? "No one is waiting for an answer."
                : offer.Asker is { } asker ? $"{asker} asks whether you'll stay. Who do you stay with?" : "Who do you stay with?";

            foreach (var route in offer.Routes)
            {
                _people.Add(new PersonCardItem(route.Key, $"Stay with {route.Name}", false));
            }

            _people.Add(new PersonCardItem(EndingRules.AloneKey, "Leave on your own", true));
            _caption = null;
            _stageLoadingText = "Setting the scene…";
            _mode = Mode.EndingOffer;
        }
        else if (state.Pending is { } pending)
        {
            _heading = $"Day {state.Clock.Day}";
            _sceneText = pending.Text;
            _mode = Mode.Scene;
        }
        else if (state.Opening is null)
        {
            _heading = state.Setting.DisplayName;
            _lede = $"This save has not chosen how you meet {state.MainLiName} yet.";
            _mode = Mode.NoOpening;
        }
        else if (state.Over)
        {
            _heading = $"The {state.Setting.Days} days are over";
            _lede = "The calendar stops here.";
            _mode = Mode.Over;
        }
        else
        {
            var slot = state.Clock.Slot.ToString();
            _heading = $"Day {state.Clock.Day} of {state.Setting.Days}";
            _caption = state.Weather is { } weather ? $"{slot} · {weather.Label}" : slot;
            _lede = state.Heading is { } heading
                ? $"{heading.Name} is going to {heading.PlaceName} with you."
                : $"{state.Setting.DisplayName}. Choose where to spend the {slot.ToLowerInvariant()}.";
            _notes =
            [
                .. state.Today.Select(ev => $"Today: {ev.Name} at {PlaceName(ev.Place)}, {ev.Time.ToString().ToLowerInvariant()}."),
                .. state.Hints,
            ];

            _invite = "";
            if (state.Invitees.Count > 0)
            {
                _people.Add(new PersonCardItem("", "Nobody", true) { Chosen = true });
                foreach (var person in state.Invitees)
                {
                    _people.Add(new PersonCardItem(person.Key, person.Name, false));
                }
            }

            // Setting off somewhere together leaves only that place to go.
            foreach (var place in state.KnownPlaces.Where(p => state.Heading is null || p.Id == state.Heading.PlaceId))
            {
                // During a shift, the workplace says so: going there works it.
                var typeName = PlaceTypes.Get(place.TypeId).DisplayName;
                _places.Add(new PlaceCardItem(place, state.OnShift && state.Job?.Place == place.Id ? $"{typeName} · your shift" : typeName)
                {
                    Thumbnail = _thumbnails.GetValueOrDefault(place.Id),
                });
            }

            // Everyone met so far stands on the backdrop, left to right, in one slot for each person the story has.
            var met = state.Met ?? [];
            foreach (var person in met)
            {
                _lineup.Add(new LineupSlot(person.Key, person.Name, true) { Portrait = _portraits.GetValueOrDefault(person.Key) });
            }

            for (var empty = met.Count; empty < state.CastSize; empty++)
            {
                _lineup.Add(new LineupSlot($"slot-{empty}", "", false));
            }

            _stageLoadingText = "Setting the scene…";
            _mode = Mode.Map;
        }

        RefreshSceneControls();
        _scrollRequest = "adate.scrollToTop";
    }

    /// <summary>The scene the player left, exactly as it was: place, words, person, replies and answers.</summary>
    private void ShowStoredScene(PlayState state, CurrentScene scene)
    {
        var outcome = scene.Outcome;
        var place = state.KnownPlaces.FirstOrDefault(p => p.Id == outcome.PlaceId);
        _stagePlace = place ?? _stagePlace;
        _outcome = outcome with { Text = scene.Text };
        _isPhone = outcome.EncounterId == JsonEncounterCatalog.PhoneId;
        _view = new SceneView(scene.Text, scene.CharacterId, scene.Speaker, null, scene.Expression, state.PendingScene?.Choices)
        {
            Open = state.PendingScene is not null,
        };

        _heading = $"Day {outcome.VisitedAt.Day}, {outcome.VisitedAt.Slot}";
        _caption = place?.Name ?? outcome.PlaceId;
        _stageLoadingText = $"Drawing {_caption}…";
        _stageBackground = null;
        _sceneText = scene.Written ? scene.Text : null;
        _isWriting = !scene.Written;
        _writingText = "Writing the scene…";
        _withLine = outcome.With.Count > 0 ? $"With: {string.Join(", ", outcome.With.Select(Who))}" : null;
        _revealLine = outcome.Reveals.Count > 0 ? $"New place: {string.Join(", ", outcome.Reveals.Select(PlaceName))}" : null;
        _noteLine = outcome.Note;
        _speaker = scene.Speaker;
        foreach (var exchange in scene.Exchanges)
        {
            _exchanges.Add(new Exchange(exchange.Reply) { Reaction = exchange.Reaction, Popup = exchange.Popup, Agreed = exchange.Agreed });
        }

        _mode = Mode.Scene;
    }

    /// <summary>
    /// Brings back a stored scene's pictures (drawn already, so they come from the cache), draws anything the scene
    /// was still waiting for, and finishes the writing if leaving interrupted it.
    /// </summary>
    private async Task RestoreSceneAsync(CurrentScene scene)
    {
        var token = _scene;

        try
        {
            var background = scene.BackgroundPath ?? await World.SceneBackgroundAsync(SaveId);
            if (token != _scene)
            {
                return;
            }

            _stageBackground = background;
            await RefreshAsync();
        }
        catch (Exception)
        {
            if (token == _scene)
            {
                _stageLoadingText = "The picture could not be drawn.";
                await RefreshAsync();
            }
        }

        if (_isPhone)
        {
            try
            {
                await ShowPortraitAsync(await World.PresentAsync(SaveId, scene.Outcome), token);
            }
            catch (Exception)
            {
                // The messages work without the picture.
            }
        }
        else if (scene.CharacterId is not null)
        {
            try
            {
                var path = scene.SpritePath;
                if (path is null)
                {
                    var presented = await World.PresentAsync(SaveId, scene.Outcome);
                    path = await World.SceneSpriteAsync(SaveId, presented with { Expression = scene.Expression ?? presented.Expression });
                }

                if (token == _scene)
                {
                    _stageSprite = path;
                    await RefreshAsync();
                }
            }
            catch (Exception)
            {
                // The words and choices work without the person's picture.
            }
        }

        if (!scene.Written)
        {
            _working = true;
            try
            {
                if (await Task.Run(() => World.ResumeSceneAsync(SaveId, WritingProgress(token))) is { } written && token == _scene)
                {
                    await ApplyWrittenAsync(written, token);
                }
            }
            catch (Exception ex)
            {
                if (token == _scene)
                {
                    ShowError(ex);
                }
            }
            finally
            {
                _working = false;
                await RefreshAsync();
            }
        }
    }

    /// <summary>
    /// What a scene offers now: the encounter's own choices before anything is said, what the player can say next
    /// while the conversation goes on (always with a reply of their own), or Continue once it has closed. Nothing
    /// while words are still being written.
    /// </summary>
    private void RefreshSceneControls()
    {
        IReadOnlyList<ProposedChoice>? replies = null;
        IReadOnlyList<EncounterChoice>? authored = null;
        var showContinue = false;

        if (_isWriting || _mode != Mode.Scene)
        {
            // The spinner stands in for the words and the choices alike; outside a scene there is nothing to pick.
        }
        else if (_exchanges.Count == 0 && (_outcome?.Choices ?? _state?.Pending?.Choices) is { Count: > 0 } choices)
        {
            authored = choices;
        }
        else if (_view is { Open: true } open)
        {
            // Nothing proposed still leaves the player's own words, beside Continue.
            replies = open.Choices ?? [];
            showContinue = replies.Count == 0;
        }
        else
        {
            showContinue = true;
        }

        _choices = authored is not null
            ? [.. authored.Select(c => new ChoiceButton(c.Text, c, null))]
            : replies is not null
                ? [.. replies.Select((c, i) => new ChoiceButton(c.Text, null, i))]
                : [];
        _canReply = replies is not null;
        _showContinue = showContinue;

        // Once a scene's conversation is over the player can text someone from there: anyone but who is here.
        _contacts = showContinue && !_isPhone && _outcome is { } here
            ? [.. (_state?.Contacts ?? []).Where(c => here.With.All(w => Who(w) != c.Name))]
            : [];
        _messages = _isPhone ? Messages() : [];
    }

    /// <summary>A conversation by text as bubbles: their messages, each of the player's replies, and what came of them.</summary>
    private List<Message> Messages()
    {
        List<Message> messages = [.. TextMessages.Split(_sceneText).Select(m => new Message(m, false, false))];
        foreach (var exchange in _exchanges)
        {
            messages.Add(new Message(TextMessages.Unquote(exchange.Reply), true, false));
            messages.AddRange(TextMessages.Split(exchange.Reaction).Select(m => new Message(m, false, false)));
            messages.AddRange(new[] { exchange.Popup, exchange.Agreed }.OfType<string>().Select(note => new Message(note, false, true)));
        }

        return messages;
    }

    /// <summary>
    /// Fills in the pictures as they arrive, never holding up the screen: the stage first, then the lineup and the
    /// people on offer at their resting expression, then each place at this slot and weather.
    /// </summary>
    private async Task LoadPicturesAsync(PlayState state)
    {
        var generation = ++_generation;
        var weather = state.Weather?.Id ?? "clear";
        var key = $"{state.Clock.Day}:{state.Clock.Slot}:{weather}";
        if (_picturesFor != key)
        {
            _thumbnails.Clear();
            _picturesFor = key;
        }

        bool Stale() => generation != _generation || _outcome is not null;

        try
        {
            if (_mode is Mode.EndingOffer or Mode.Ending or Mode.Map)
            {
                _backdrop ??= await Studio.GenerateBackdropAsync(SaveId);
                if (Stale())
                {
                    return;
                }

                _stageBackground = _backdrop;
                await RefreshAsync();
            }
            else if (_mode is Mode.Scene
                     && (_stagePlace ?? state.KnownPlaces.FirstOrDefault(p => p.Id == state.LastPlaceId) ?? state.KnownPlaces.FirstOrDefault()) is { } here)
            {
                if (_stageBackground is null)
                {
                    _stageLoadingText = $"Drawing {here.Name}…";
                    await RefreshAsync();
                }

                var background = await Studio.GenerateBackgroundAsync(SaveId, here, state.Clock.Slot, weather);
                if (Stale())
                {
                    return;
                }

                _stageBackground = background;
                await RefreshAsync();
            }
        }
        catch (Exception)
        {
            _stageLoadingText = "The picture could not be drawn.";
            await RefreshAsync();
        }

        // Everyone standing on the map, and everyone on offer, drawn once at their resting expression.
        foreach (var personKey in _lineup.Where(s => s.IsMet).Select(s => s.Key).Concat(_people.Where(p => !p.IsNobody).Select(p => p.Key)).Distinct().ToList())
        {
            if (!_portraits.ContainsKey(personKey))
            {
                try
                {
                    if (await World.PortraitAsync(SaveId, personKey) is { } portrait)
                    {
                        _portraits[personKey] = portrait;
                    }
                }
                catch (Exception)
                {
                    // A missing picture leaves the card with its name; the choice still works.
                }
            }

            if (Stale())
            {
                return;
            }

            foreach (var slot in _lineup.Where(s => s.Key == personKey))
            {
                slot.Portrait = _portraits.GetValueOrDefault(personKey);
            }

            foreach (var card in _people.Where(p => p.Key == personKey))
            {
                card.Portrait = _portraits.GetValueOrDefault(personKey);
            }

            await RefreshAsync();
        }

        foreach (var card in _places.ToList())
        {
            if (!_thumbnails.TryGetValue(card.Place.Id, out var thumbnail))
            {
                try
                {
                    thumbnail = await Studio.GenerateBackgroundAsync(SaveId, card.Place, state.Clock.Slot, weather);
                    if (_picturesFor == key)
                    {
                        _thumbnails[card.Place.Id] = thumbnail;
                    }
                }
                catch (Exception)
                {
                    // The place stays choosable by name.
                }
            }

            // The player moved on while this one was drawing; stop drawing for a screen that is gone.
            if (Stale())
            {
                return;
            }

            card.Thumbnail = thumbnail;
            await RefreshAsync();
        }
    }

    /// <summary>
    /// While the player reads a scene, draws what the next map needs: every known place at the slot and weather the
    /// clock has moved on to. They are cached, so the map shows them straight away.
    /// </summary>
    private async Task PrewarmMapAsync()
    {
        try
        {
            var next = await World.GetPlayStateAsync(SaveId);
            if (next.Over || next.EndingOffer is not null || next.Ending is not null)
            {
                return;
            }

            var weather = next.Weather?.Id ?? "clear";
            foreach (var place in next.KnownPlaces)
            {
                await Studio.GenerateBackgroundAsync(SaveId, place, next.Clock.Slot, weather);
            }
        }
        catch (Exception)
        {
            // Only a head start: the map draws whatever is still missing when it opens.
        }
    }

    private async Task PersonPickedAsync(PersonCardItem card)
    {
        foreach (var person in _people)
        {
            person.Chosen = person == card;
        }

        if (_mode == Mode.Map)
        {
            _invite = card.Key;
            return;
        }

        _working = true;
        _lede = "Writing the ending.";

        try
        {
            await World.EndAsync(SaveId, card.Key);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            ShowError(ex);
        }
        finally
        {
            _working = false;
        }
    }

    /// <summary>Passing time at a place.</summary>
    private Task GoAsync(PlaceCardItem card) =>
        TurnAsync(card.Place.Name, card.Place, () => World.TakeTurnAsync(SaveId, card.Place.Id, string.IsNullOrEmpty(_invite) ? null : _invite));

    /// <summary>Texting someone whose number the player has, from where they are, once the scene's conversation is over.</summary>
    private Task TextAsync(Invitee contact) =>
        TurnAsync(_caption ?? contact.Name, _stagePlace, () => World.TextAsync(SaveId, contact.Key), phone: true);

    /// <param name="caption">What the stage says: the place's name.</param>
    /// <param name="place">Where the turn is spent, remembered for the stage.</param>
    /// <param name="phone">A conversation by text at the place already on screen: its picture stays, blurred, and nobody stands there.</param>
    private async Task TurnAsync(string caption, PlaceRecord? place, Func<Task<TurnOutcome>> take, bool phone = false)
    {
        _working = true;
        var token = ++_scene;

        try
        {
            // On screen at once: the place's name, a spinner while its picture is drawn, and one while the words are
            // written. The placeholder text never shows unless the model cannot write the scene.
            _outcome = null;
            _view = null;
            _isPhone = phone;
            _phonePortrait = null;
            if (!phone)
            {
                _stageBackground = null;
            }

            _stageSprite = null;
            _speaker = null;
            _exchanges.Clear();
            _withLine = null;
            _revealLine = null;
            _noteLine = null;
            _sceneText = null;
            _caption = caption;
            _stageLoadingText = $"Drawing {caption}…";
            _writingText = phone ? "Opening your messages…" : $"Seeing who is at {caption}…";
            _isWriting = true;
            _mode = Mode.Scene;
            RefreshSceneControls();
            _scrollRequest = "adate.scrollToTop";
            await RefreshAsync();

            // Off the circuit: the database calls finish synchronously, so until the model was asked nothing was drawn.
            var outcome = await Task.Run(take);
            _invite = "";
            _outcome = outcome;
            if (place is not null)
            {
                _stagePlace = place;
            }

            _heading = $"Day {outcome.VisitedAt.Day}, {outcome.VisitedAt.Slot}";
            _withLine = outcome.With.Count > 0 ? $"With: {string.Join(", ", outcome.With.Select(Who))}" : null;
            _revealLine = outcome.Reveals.Count > 0 ? $"New place: {string.Join(", ", outcome.Reveals.Select(PlaceName))}" : null;
            _noteLine = outcome.Note;

            // Whoever the scene is about steps in at their resting expression.
            var presented = await Task.Run(() => World.PresentAsync(SaveId, outcome));
            _view = presented;
            _speaker = presented.Name;
            _writingText = "Setting the scene…";
            await RefreshAsync();

            // The picture, the person and the words at once: the image service and the model work side by side.
            var background = ShowBackgroundAsync(token);
            var sprite = phone ? ShowPortraitAsync(presented, token) : ShowSpriteAsync(presented, token);
            var written = await Task.Run(() => World.WriteSceneAsync(SaveId, outcome, WritingProgress(token)));

            if (token != _scene)
            {
                return;
            }

            // The resting sprite is saved before the written expression's, so the later one stays.
            if (written.CharacterId is not null && written.Expression != presented.Expression)
            {
                await sprite;
            }

            await ApplyWrittenAsync(written, token);
            await background;
            await sprite;

            _ = PrewarmMapAsync();
        }
        catch (Exception ex)
        {
            ShowError(ex);
        }
        finally
        {
            _working = false;
            await RefreshAsync();
        }
    }

    /// <summary>What the world is doing for the scene, under the spinner, for as long as the scene is the one on screen.</summary>
    private Progress<string> WritingProgress(int token) => new(step =>
    {
        if (token == _scene && _isWriting)
        {
            _writingText = step;
            _ = RefreshAsync();
        }
    });

    private async Task ShowBackgroundAsync(int token)
    {
        try
        {
            var picture = await World.SceneBackgroundAsync(SaveId);
            if (token == _scene)
            {
                _stageBackground = picture;
                await RefreshAsync();
            }
        }
        catch (Exception)
        {
            if (token == _scene)
            {
                _stageLoadingText = "The picture could not be drawn.";
                await RefreshAsync();
            }
        }
    }

    private async Task ShowSpriteAsync(SceneView view, int token)
    {
        if (view.CharacterId is null)
        {
            return;
        }

        try
        {
            var picture = await World.SceneSpriteAsync(SaveId, view);

            // A written expression that arrived meanwhile has its own picture; this one is out of date.
            if (token == _scene && _view?.Expression == view.Expression)
            {
                _stageSprite = picture;
                await RefreshAsync();
            }
        }
        catch (Exception)
        {
            // The scene works without the person's picture.
        }
    }

    /// <summary>The small round picture at the top of a conversation by text: the person at their resting expression.</summary>
    private async Task ShowPortraitAsync(SceneView view, int token)
    {
        try
        {
            var picture = await World.SpriteAsync(SaveId, view);
            if (token == _scene)
            {
                _phonePortrait = picture;
                await RefreshAsync();
            }
        }
        catch (Exception)
        {
            // The messages work without the picture.
        }
    }

    /// <summary>The written scene replaces the spinner; a different expression brings its own picture.</summary>
    private async Task ApplyWrittenAsync(SceneView written, int token)
    {
        var expressionChanged = !_isPhone && written.CharacterId is not null && written.Expression != _view?.Expression;

        _outcome = _outcome is null ? null : _outcome with { Text = written.Text };
        _view = written;
        _speaker = written.Name ?? _speaker;
        _sceneText = written.Text;
        _isWriting = false;
        RefreshSceneControls();
        await RefreshAsync();

        if (expressionChanged)
        {
            try
            {
                var picture = await World.SceneSpriteAsync(SaveId, written);
                if (token == _scene)
                {
                    _stageSprite = picture;
                    await RefreshAsync();
                }
            }
            catch (Exception)
            {
                // Keeps the resting picture.
            }
        }
    }

    private Task PickChoiceAsync(ChoiceButton choice) =>
        choice.Authored is { } authored ? ChooseAsync(authored) : AnswerAsync(choice.Index);

    private async Task ChooseAsync(EncounterChoice choice)
    {
        _working = true;
        var token = _scene;
        var exchange = BeginExchange(choice.Text);

        try
        {
            // The people there answer the choice like any reply; only a choice nobody hears moves straight on.
            if (await World.ChooseAsync(SaveId, choice.Id) is { } result)
            {
                if (token != _scene)
                {
                    return;
                }

                ApplyReaction(exchange, result);
                await ShowReactionSpriteAsync(result, token);
            }
            else
            {
                await ContinueCoreAsync();
            }
        }
        catch (Exception ex)
        {
            _exchanges.Remove(exchange);
            ShowError(ex);
        }
        finally
        {
            _working = false;
        }
    }

    /// <summary>The player's words join the conversation at once, with a spinner while the others answer.</summary>
    private Exchange BeginExchange(string words)
    {
        var exchange = new Exchange(words);
        _exchanges.Add(exchange);
        _writingText = _speaker is { } who ? $"{who} is answering…" : "Writing what happens…";
        _isWriting = true;
        RefreshSceneControls();
        _scrollRequest = "adate.scrollToEnd";
        StateHasChanged();
        return exchange;
    }

    /// <summary>The answer joins the conversation; new replies keep it going, and without them Continue ends it.</summary>
    private void ApplyReaction(Exchange exchange, ReactionResult result)
    {
        exchange.Reaction = result.View.Text;
        exchange.Popup = result.Popup;
        exchange.Agreed = result.Agreed;
        _view = (_view ?? result.View) with { Choices = result.Next is { Count: > 0 } next ? next : null, Open = result.Open };
        if (result.Together && _state is not null)
        {
            // Setting off together: nobody to text before going.
            _state = _state with { Contacts = [] };
        }

        _isWriting = false;
        RefreshSceneControls();
        _scrollRequest = "adate.scrollToEnd";
        StateHasChanged();
    }

    /// <summary>A different expression in the answer brings the person's picture for it.</summary>
    private async Task ShowReactionSpriteAsync(ReactionResult result, int token)
    {
        if (_isPhone || result.View.CharacterId is null || _view is null || (result.View.Expression == _view.Expression && !result.Redressed))
        {
            return;
        }

        _view = _view with
        {
            CharacterId = result.View.CharacterId,
            Name = result.View.Name ?? _view.Name,
            Aesthetic = result.View.Aesthetic ?? _view.Aesthetic,
            Expression = result.View.Expression,
        };

        try
        {
            var picture = await World.SceneSpriteAsync(SaveId, result.View);
            if (token == _scene)
            {
                _stageSprite = picture;
            }
        }
        catch (Exception)
        {
            // Keeps the picture already shown.
        }
    }

    /// <summary>The player's own words.</summary>
    private Task ReplyAsync() => string.IsNullOrWhiteSpace(_reply) || _working ? Task.CompletedTask : AnswerAsync(null);

    private async Task AnswerAsync(int? index)
    {
        var words = index is { } i ? _choices.ElementAtOrDefault(i)?.Text : _reply.Trim();
        if (string.IsNullOrWhiteSpace(words))
        {
            return;
        }

        _working = true;
        var token = _scene;
        var freeText = index is null ? _reply : null;
        var exchange = BeginExchange(words);

        try
        {
            var result = await World.RespondAsync(SaveId, index, freeText);
            if (token != _scene)
            {
                return;
            }

            _reply = "";
            ApplyReaction(exchange, result);
            await ShowReactionSpriteAsync(result, token);
        }
        catch (Exception ex)
        {
            _exchanges.Remove(exchange);
            ShowError(ex);
        }
        finally
        {
            _working = false;
        }
    }

    private async Task ContinueAsync()
    {
        _working = true;
        try
        {
            await ContinueCoreAsync();
        }
        finally
        {
            _working = false;
        }
    }

    private async Task ContinueCoreAsync()
    {
        await World.CloseSceneAsync(SaveId);
        _outcome = null;
        _view = null;
        await ReloadAsync();
    }

    private Task RetryAsync()
    {
        _outcome = null;
        return ReloadAsync();
    }

    /// <summary>Ten quick taps on the title, within four seconds, open the debug screen.</summary>
    private async Task TitleTapped()
    {
        var now = DateTime.UtcNow;
        _taps.Enqueue(now);
        while (_taps.Count > 0 && (now - _taps.Peek()).TotalSeconds > 4)
        {
            _taps.Dequeue();
        }

        if (_taps.Count >= 10)
        {
            _taps.Clear();
            await OpenDebugAsync();
        }
    }

    private async Task OpenDebugAsync()
    {
        _debugOpen = true;
        try
        {
            _debugSections = await World.DebugReportAsync(SaveId);
        }
        catch (Exception ex)
        {
            _debugSections = [new DebugSection("Error", [ex.ToString()])];
        }
    }

    private void ShowError(Exception ex)
    {
        _error = ex.Message;
        _heading = "Something went wrong";
        _speaker = null;
        _isWriting = false;
        _isPhone = false;
        _mode = Mode.Error;
    }

    private string PlaceName(string placeId) =>
        _state?.KnownPlaces.FirstOrDefault(p => p.Id == placeId)?.Name
        ?? _state?.Setting.Places.FirstOrDefault(p => p.Id == placeId)?.Name
        ?? placeId;

    private string Who(string reference) =>
        _state?.People.GetValueOrDefault(reference) ?? reference;
}
