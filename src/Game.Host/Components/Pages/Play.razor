@page "/play/{SaveGuid:guid}"
@using Game.Core.Content
@using Game.Core.Encounters
@using Game.Core.Places
@using Game.Core.Saves
@using Game.Play
@inject WorldService World
@inject CharacterStudio Studio
@inject ILocationCatalog PlaceTypes
@rendermode InteractiveServer

<PageTitle>Play</PageTitle>

@if (_error is not null)
{
    <h1>Play</h1>
    <div class="error">
        <strong>Something went wrong.</strong>
        <p>@_error</p>
        <button @onclick="RetryAsync">Try again</button>
    </div>
}
else if (_state is null)
{
    <h1>Play</h1>
    <div class="working"><p>Loading the save.</p></div>
}
else if (_outcome is not null)
{
    <h1>Day @_outcome.VisitedAt.Day, @_outcome.VisitedAt.Slot</h1>

    <div class="stage">
        @if (_background is not null)
        {
            <img class="layer background" src="@_background" alt="@_outcomePlace?.Name" />
        }

        @if (_sprite is not null)
        {
            <img class="layer sprite shown" src="@_sprite" alt="@_view?.Name" />
        }
    </div>

    <p class="encounter-text">@_outcome.Text</p>

    @if (_outcome.With.Count > 0)
    {
        <p class="encounter-with">With: @string.Join(", ", _outcome.With.Select(Who))</p>
    }

    @if (_outcome.Reveals.Count > 0)
    {
        <p class="encounter-with">New place: @string.Join(", ", _outcome.Reveals.Select(PlaceName))</p>
    }

    @if (_outcome.Choices is { Count: > 0 } choices)
    {
        <div class="choices">
            @foreach (var choice in choices)
            {
                <button type="button" disabled="@_working" @onclick="() => ChooseAsync(choice)">@choice.Text</button>
            }
        </div>
    }
    else if (_reaction is not null)
    {
        <p class="encounter-text reaction">@_reaction</p>
        @if (_popup is not null)
        {
            <div class="popup" role="status">@_popup</div>
        }
        @if (_agreed is not null)
        {
            <p class="today">@_agreed</p>
        }
        <button type="button" disabled="@_working" @onclick="ContinueAsync">Continue</button>
    }
    else if (_view?.Choices is { Count: > 0 } offered)
    {
        <div class="choices">
            @for (var i = 0; i < offered.Count; i++)
            {
                var index = i;
                <button type="button" disabled="@_working" @onclick="() => RespondAsync(index)">@offered[index].Text</button>
            }
        </div>
        <form class="reply-form" @onsubmit="() => RespondAsync(null)">
            <input type="text" @bind="_reply" @bind:event="oninput" maxlength="300" placeholder="Or say or do something else…" disabled="@_working" />
            <button type="submit" disabled="@_working">Reply</button>
        </form>
    }
    else
    {
        <button type="button" disabled="@_working" @onclick="ContinueAsync">Continue</button>
    }
}
else if (_state.PendingScene is { } waiting)
{
    <h1>Day @waiting.Clock.Day, @waiting.Clock.Slot</h1>
    <p class="encounter-text">@waiting.Text</p>

    @if (_reaction is not null)
    {
        <p class="encounter-text reaction">@_reaction</p>
        @if (_popup is not null)
        {
            <div class="popup" role="status">@_popup</div>
        }
        @if (_agreed is not null)
        {
            <p class="today">@_agreed</p>
        }
        <button type="button" disabled="@_working" @onclick="ContinueAsync">Continue</button>
    }
    else
    {
        <div class="choices">
            @for (var i = 0; i < waiting.Choices.Count; i++)
            {
                var index = i;
                <button type="button" disabled="@_working" @onclick="() => RespondAsync(index)">@waiting.Choices[index].Text</button>
            }
        </div>
        <form class="reply-form" @onsubmit="() => RespondAsync(null)">
            <input type="text" @bind="_reply" @bind:event="oninput" maxlength="300" placeholder="Or say or do something else…" disabled="@_working" />
            <button type="submit" disabled="@_working">Reply</button>
        </form>
    }
}
else if (_state.Ending is { } ending)
{
    <h1>@(ending.PartnerName is null ? "On your own" : $"With {ending.PartnerName}")</h1>
    <p class="encounter-text">@ending.Text</p>

    @if (ending.Departures.Count > 0)
    {
        <h2>Who walked away</h2>
        <ul>
            @foreach (var departure in ending.Departures)
            {
                <li>@departure</li>
            }
        </ul>
    }

    @if (ending.PassedOver.Count > 0)
    {
        <h2>Who you passed over</h2>
        <p>@string.Join(", ", ending.PassedOver)</p>
    }

    @if (ending.Choices is { Count: > 0 } madeChoices)
    {
        <h2>Your choices</h2>
        <ol class="recap">
            @foreach (var line in madeChoices)
            {
                <li>
                    <span class="recap-when">Day @line.Day, @line.Slot.ToLowerInvariant()</span>
                    <span class="recap-words">“@line.Words”</span>
                    <span class="recap-influence">@string.Join(" · ", line.Influence)</span>
                </li>
            }
        </ol>
    }

    @if (ending.ProfileOf is not null)
    {
        <h2>@ending.ProfileOf</h2>
        <ul>
            @foreach (var line in ending.Profile)
            {
                <li>@line</li>
            }
        </ul>
    }

    <p><a href="/">Start another story</a></p>
}
else if (_state.EndingOffer is { } offer)
{
    <h1>@(_state.Over ? $"The {_state.Setting.Days} days are over" : "It is time to decide")</h1>

    @foreach (var departure in offer.Departures)
    {
        <p class="today">@departure</p>
    }

    <p class="lede">
        @(offer.Routes.Count == 0
            ? "No one is waiting for an answer."
            : offer.Asker is { } asker ? $"{asker} asks whether you'll stay. Who do you stay with?" : "Who do you stay with?")
    </p>

    @if (_working)
    {
        <div class="working"><p>Writing the ending.</p></div>
    }

    <div class="person-cards">
        @foreach (var route in offer.Routes)
        {
            <button type="button" class="person-card" disabled="@_working" @onclick="() => EndAsync(route.Key)">
                <span class="person-picture" style="@(_backdrop is null ? null : $"background-image: url('{_backdrop}')")">
                    @if (_portraits.GetValueOrDefault(route.Key) is { } portrait)
                    {
                        <img src="@portrait" alt="" />
                    }
                    else
                    {
                        <span class="picture-wait" aria-hidden="true"></span>
                    }
                </span>
                <span class="person-name">Stay with @route.Name</span>
            </button>
        }
        <button type="button" class="person-card nobody" disabled="@_working" @onclick="() => EndAsync(Game.Core.Story.EndingRules.AloneKey)">
            <span class="person-picture"><span class="person-none">—</span></span>
            <span class="person-name">Leave on your own</span>
        </button>
    </div>
}
else if (_state.Pending is not null)
{
    <h1>Day @_state.Clock.Day</h1>
    <p class="encounter-text">@_state.Pending.Text</p>
    <div class="choices">
        @foreach (var choice in _state.Pending.Choices)
        {
            <button type="button" disabled="@_working" @onclick="() => ChooseAsync(choice)">@choice.Text</button>
        }
    </div>
}
else if (_state.Opening is null)
{
    <h1>@_state.Setting.DisplayName</h1>
    <p class="lede">This save has not chosen how you meet @_state.MainLiName yet.</p>
    <p><a href="/opening/@SaveGuid">Choose an opening</a></p>
}
else if (_state.Over)
{
    <h1>The @_state.Setting.Days days are over</h1>
    <p class="lede">Endings arrive in a later build step. For now, this is where the calendar stops.</p>
}
else
{
    <div class="map-header">
        <h1>Day @_state.Clock.Day of @_state.Setting.Days</h1>
        <span class="map-slot">@_state.Clock.Slot@(_state.Weather is { } weather ? $" · {weather.Label}" : "")</span>
    </div>

    <p class="lede">
        @_state.Setting.DisplayName. Choose where to spend the @_state.Clock.Slot.ToString().ToLowerInvariant().
        @if (_state.MainLiId is { } mainId)
        {
            <a href="/scene/@mainId">Scene viewer</a>
        }
    </p>

    @foreach (var ev in _state.Today)
    {
        <p class="today">Today: @ev.Name at @PlaceName(ev.Place), @ev.Time.ToString().ToLowerInvariant().</p>
    }

    @foreach (var hint in _state.Hints)
    {
        <p class="today">@hint</p>
    }

    @if (_state.Invitees.Count > 0)
    {
        <h2 class="map-section">Bring someone along</h2>
        <div class="person-cards" role="radiogroup" aria-label="Invite along">
            <button type="button" role="radio" aria-checked="@(_invite == "")"
                    class="person-card nobody @(_invite == "" ? "chosen" : "")" @onclick='() => _invite = ""'>
                <span class="person-picture"><span class="person-none">—</span></span>
                <span class="person-name">Nobody</span>
            </button>
            @foreach (var person in _state.Invitees)
            {
                <button type="button" role="radio" aria-checked="@(_invite == person.Key)"
                        class="person-card @(_invite == person.Key ? "chosen" : "")" @onclick="() => _invite = person.Key">
                    <span class="person-picture" style="@(_backdrop is null ? null : $"background-image: url('{_backdrop}')")">
                        @if (_portraits.GetValueOrDefault(person.Key) is { } portrait)
                        {
                            <img src="@portrait" alt="" />
                        }
                        else
                        {
                            <span class="picture-wait" aria-hidden="true"></span>
                        }
                    </span>
                    <span class="person-name">@person.Name</span>
                </button>
            }
        </div>
    }

    <h2 class="map-section">Where to</h2>
    <div class="map-places">
        @foreach (var place in _state.KnownPlaces)
        {
            <button type="button" class="place-card" disabled="@_working" @onclick="() => GoAsync(place)">
                <span class="place-picture">
                    @if (_thumbnails.GetValueOrDefault(place.Id) is { } thumbnail)
                    {
                        <img src="@thumbnail" alt="" />
                    }
                    else
                    {
                        <span class="picture-wait" aria-hidden="true"></span>
                    }
                </span>
                <span class="place-name">@place.Name</span>
                <small>@PlaceTypes.Get(place.TypeId).DisplayName</small>
            </button>
        }
    </div>
}

@code {
    [Parameter]
    public Guid SaveGuid { get; set; }

    /// <summary>An opening's meeting place, to go straight into instead of showing the map.</summary>
    [SupplyParameterFromQuery]
    public string? Start { get; set; }

    private SaveId SaveId => new(SaveGuid);

    private PlayState? _state;
    private TurnOutcome? _outcome;
    private PlaceRecord? _outcomePlace;
    private string? _background;
    private string? _sprite;
    private SceneView? _view;
    private string? _reaction;
    private string? _popup;
    private string? _agreed;
    private string _reply = "";
    private string _invite = "";
    private bool _working;
    private string? _error;

    // Map pictures, keyed by place id and invitee key, for the slot and weather they were drawn for.
    private readonly Dictionary<string, string> _thumbnails = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _portraits = new(StringComparer.Ordinal);
    private string? _picturesFor;

    // One neutral backdrop, shared by every person card, with the cut-out sprites standing on it.
    private string? _backdrop;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        if (Start is { } start
            && _state is { Opening: not null, Pending: null, PendingScene: null, Scene: null, EndingOffer: null, Ending: null, Over: false }
            && _state.KnownPlaces.FirstOrDefault(p => p.Id == start) is { } place)
        {
            await GoAsync(place);
        }
    }

    private async Task LoadAsync()
    {
        _error = null;

        try
        {
            _state = await World.GetPlayStateAsync(SaveId);
            _ = LoadPicturesAsync(_state);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    /// <summary>
    /// Fills in the map's pictures one by one as they arrive, never holding up the map: backgrounds
    /// at this slot and weather, and each invitee at their resting expression. Cached images come
    /// back at once; the rest render once and are cached for every later visit.
    /// </summary>
    private async Task LoadPicturesAsync(PlayState state)
    {
        var key = $"{state.Clock.Day}:{state.Clock.Slot}:{state.Weather?.Id ?? "clear"}";
        if (_picturesFor != key)
        {
            _thumbnails.Clear();
            _picturesFor = key;
        }

        // Everyone the player can pick right now: along for a visit, or to stay with at the end.
        IReadOnlyList<Invitee> people = [.. state.Invitees, .. state.EndingOffer?.Routes ?? []];

        if (_backdrop is null && people.Count > 0)
        {
            try
            {
                _backdrop = await Studio.GenerateBackdropAsync();
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception)
            {
                // Without the backdrop the cards keep their plain ground.
            }
        }

        foreach (var person in people.Where(p => !_portraits.ContainsKey(p.Key)))
        {
            try
            {
                if (await World.PortraitAsync(SaveId, person.Key) is { } portrait)
                {
                    _portraits[person.Key] = portrait;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (Exception)
            {
                // A missing picture leaves the card with its name; the choice still works.
            }
        }

        foreach (var place in state.KnownPlaces.Where(p => !_thumbnails.ContainsKey(p.Id)))
        {
            try
            {
                var thumbnail = await Studio.GenerateBackgroundAsync(SaveId, place, state.Clock.Slot, state.Weather?.Id ?? "clear");
                if (_picturesFor == key)
                {
                    _thumbnails[place.Id] = thumbnail;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (Exception)
            {
                // As above: the place stays choosable by name.
            }

            // The player moved on to another slot while this one was drawing; stop drawing it.
            if (_picturesFor != key || _outcome is not null)
            {
                return;
            }
        }
    }

    private async Task RetryAsync()
    {
        _outcome = null;
        await LoadAsync();
    }

    private async Task GoAsync(PlaceRecord place)
    {
        _working = true;

        try
        {
            _outcome = await World.TakeTurnAsync(SaveId, place.Id, string.IsNullOrEmpty(_invite) ? null : _invite);
            _invite = "";
            _outcomePlace = place;
            _background = null;
            StateHasChanged();

            // Drawn at the slot the visit happened in, and saved with the scene.
            _background = await World.SceneBackgroundAsync(SaveId);
            StateHasChanged();

            // Whoever the scene is about steps in at their resting expression straight away.
            _view = await World.PresentAsync(SaveId, _outcome);
            _sprite = await World.SceneSpriteAsync(SaveId, _view);
            StateHasChanged();

            // Written once the placeholder, background and sprite are on screen, so a slow or absent
            // model never holds up the turn itself. The written expression replaces the resting one.
            var written = await World.WriteSceneAsync(SaveId, _outcome);
            _outcome = _outcome with { Text = written.Text };

            var expressionChanged = written.Expression != _view.Expression;
            _view = written;
            StateHasChanged();

            if (expressionChanged)
            {
                _sprite = await World.SceneSpriteAsync(SaveId, written);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _working = false;
        }
    }

    private async Task ChooseAsync(EncounterChoice choice)
    {
        _working = true;

        try
        {
            // The people there answer the choice like any reply; a choice nobody hears moves straight on.
            var result = await World.ChooseAsync(SaveId, choice.Id);
            if (result is null)
            {
                await ContinueAsync();
            }
            else if (_outcome is null)
            {
                await LoadAsync();
            }
            else
            {
                ShowReaction(result);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _working = false;
        }
    }

    /// <summary>A proposed reply by index, or the typed one when <paramref name="index"/> is null.</summary>
    private async Task RespondAsync(int? index)
    {
        if (index is null && string.IsNullOrWhiteSpace(_reply))
        {
            return;
        }

        _working = true;

        try
        {
            var result = await World.RespondAsync(SaveId, index, index is null ? _reply : null);
            var expressionBefore = _view?.Expression;
            ShowReaction(result);
            _reply = "";
            StateHasChanged();

            if (_outcome is not null && result.View.CharacterId is not null && result.View.Expression != expressionBefore)
            {
                _view = (_view ?? result.View) with { Expression = result.View.Expression };
                _sprite = await World.SceneSpriteAsync(SaveId, result.View);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _working = false;
        }
    }

    /// <summary>
    /// The answer joins the scene's words. While the conversation goes on the next replies are offered;
    /// once it closes, Continue moves on.
    /// </summary>
    private void ShowReaction(ReactionResult result)
    {
        _popup = result.Popup;
        _agreed = result.Agreed;

        if (_outcome is not null)
        {
            _outcome = _outcome with { Text = result.Transcript, Choices = [] };
            _view = (_view ?? result.View) with { Choices = result.Next is { Count: > 0 } next ? next : null };
            _reaction = null;
        }
        else if (result.Next is { Count: > 0 } more && _state?.PendingScene is { } waiting)
        {
            _state = _state with { PendingScene = waiting with { Text = result.Transcript, Choices = more } };
            _reaction = null;
        }
        else
        {
            _reaction = result.View.Text;
        }
    }

    private async Task EndAsync(string pick)
    {
        _working = true;

        try
        {
            await World.EndAsync(SaveId, pick);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _working = false;
        }
    }

    private async Task ContinueAsync()
    {
        await World.CloseSceneAsync(SaveId);
        _outcome = null;
        _outcomePlace = null;
        _background = null;
        _sprite = null;
        _view = null;
        _reaction = null;
        _popup = null;
        _agreed = null;
        _reply = "";
        await LoadAsync();
    }

    private string PlaceName(string placeId) =>
        _state?.Setting.Places.FirstOrDefault(p => p.Id == placeId)?.Name ?? placeId;

    private string Who(string reference) =>
        _state?.People.GetValueOrDefault(reference) ?? reference;
}
