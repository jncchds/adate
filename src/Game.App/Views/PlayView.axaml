<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Game.App.ViewModels"
             xmlns:play="using:Game.Play"
             xmlns:ctl="using:Game.App.Controls"
             xmlns:sys="using:System"
             x:Class="Game.App.Views.PlayView"
             x:DataType="vm:PlayViewModel">

    <UserControl.Resources>
        <!-- A person standing on the shared neutral backdrop, or a dash for nobody. -->
        <DataTemplate x:Key="PersonCard" x:DataType="vm:PersonCardViewModel">
            <Button Classes="card" Classes.chosen="{Binding IsChosen}"
                    Command="{Binding Command}" CommandParameter="{Binding}">
                <StackPanel Spacing="4">
                    <Panel Height="160" ClipToBounds="True">
                        <Border Classes="wait" />
                        <Image Source="{Binding Backdrop}" Stretch="UniformToFill" />
                        <TextBlock Text="—" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding IsNobody}" />
                        <ctl:SpriteFrame>
                            <Image Source="{Binding Portrait}" />
                        </ctl:SpriteFrame>
                        <ctl:Spinner Classes="spinner small" IsVisible="{Binding IsWaiting}" />
                    </Panel>
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="Note" x:DataType="sys:String">
            <TextBlock Classes="note" Text="{Binding}" />
        </DataTemplate>
    </UserControl.Resources>

    <ctl:StageLayout Tall="{Binding !IsScene}">
        <!-- The stage: always a picture, never scrolled away. -->
        <Panel Classes="stage" ClipToBounds="True">
            <Image Source="{Binding StageBackground}" Stretch="UniformToFill" />

            <!-- On the map: everyone met so far, standing left to right on the backdrop, one slot per person. -->
            <ItemsControl ItemsSource="{Binding Lineup}" IsVisible="{Binding IsMap}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LineupItem">
                        <Panel ClipToBounds="True">
                            <ctl:SpriteFrame>
                                <Image Source="{Binding Portrait}" />
                            </ctl:SpriteFrame>
                            <ctl:Spinner Classes="spinner small" IsVisible="{Binding IsWaiting}" />
                            <Border Classes="lineup-name" IsVisible="{Binding IsMet}">
                                <TextBlock Text="{Binding Name}" />
                            </Border>
                        </Panel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Panel>

        <!-- The person the scene is about, at the left in landscape and over the picture in portrait; and
             while the picture is on its way, a spinner saying what is being drawn, where no text box covers it. -->
        <Panel>
            <ctl:SpriteFrame>
                <Image Source="{Binding StageSprite}" />
            </ctl:SpriteFrame>
            <Border Classes="loading" IsVisible="{Binding IsStageLoading}">
                <StackPanel Spacing="10">
                    <ctl:Spinner Classes="spinner" />
                    <TextBlock Classes="lede" Text="{Binding StageLoadingText}" TextAlignment="Center" MaxWidth="240" />
                </StackPanel>
            </Border>
        </Panel>

        <!-- The words: a header with the title and the name tag, and everything else scrolling below. -->
        <Border Classes="textbox">
            <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,6">
                    <!-- Ten quick taps on the title open the debug screen. -->
                    <TextBlock x:Name="Title" Classes="title" Background="Transparent" Text="{Binding Heading}" />
                    <Border Grid.Column="1" Classes="nametag"
                            IsVisible="{Binding Speaker, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding Speaker}" />
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="1" x:Name="Side">
                    <StackPanel Classes="side">
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsLoading}">
                            <ctl:Spinner Classes="spinner small" />
                            <TextBlock Classes="lede" Text="Loading the save…" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsError}" Spacing="10">
                            <TextBlock Classes="error" Text="{Binding Error}" />
                            <Button Classes="accent" Content="Try again" Command="{Binding RetryCommand}" />
                        </StackPanel>

                        <!-- A scene is a conversation: its words, each reply with the answer to it, then what the player can say next. -->
                        <StackPanel IsVisible="{Binding IsScene}" Spacing="12">
                            <TextBlock Classes="story" Text="{Binding SceneText}"
                                       IsVisible="{Binding SceneText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Classes="small" Text="{Binding WithLine}"
                                       IsVisible="{Binding WithLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Classes="small" Text="{Binding RevealLine}"
                                       IsVisible="{Binding RevealLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Classes="note" Text="{Binding NoteLine}"
                                       IsVisible="{Binding NoteLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <ItemsControl ItemsSource="{Binding Exchanges}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ExchangeItem">
                                        <StackPanel Spacing="10" Margin="0,4,0,8">
                                            <Border Classes="reply">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Classes="small" Text="You" />
                                                    <TextBlock Classes="story" Text="{Binding Reply}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Classes="story reaction" Text="{Binding Reaction}"
                                                       IsVisible="{Binding Reaction, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <Border Classes="popup" IsVisible="{Binding Popup, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="{Binding Popup}" TextWrapping="Wrap" />
                                            </Border>
                                            <TextBlock Classes="note" Text="{Binding Agreed}"
                                                       IsVisible="{Binding Agreed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsWriting}">
                                <ctl:Spinner Classes="spinner small" />
                                <TextBlock Classes="lede" Text="{Binding WritingText}" VerticalAlignment="Center" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Choices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChoiceItem">
                                        <Button Classes="choice" Command="{Binding Command}" CommandParameter="{Binding Parameter}">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel IsVisible="{Binding CanReply}" Spacing="8">
                                <TextBox Text="{Binding ReplyText}" MaxLength="300" TextWrapping="Wrap"
                                         PlaceholderText="Or say or do something else…">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding ReplyCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Content="Reply" Command="{Binding ReplyCommand}" />
                            </StackPanel>
                            <Button Classes="accent" Content="Continue" IsVisible="{Binding ShowContinue}" Command="{Binding ContinueCommand}" />
                        </StackPanel>

                        <!-- The map: who comes along, and where to go. -->
                        <StackPanel IsVisible="{Binding IsMap}" Spacing="12">
                            <TextBlock Classes="lede" Text="{Binding Lede}" />
                            <ItemsControl ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource Note}" />

                            <StackPanel IsVisible="{Binding HasPeople}" Spacing="8">
                                <TextBlock Classes="h2" Text="Bring someone along" />
                                <ItemsControl ItemsSource="{Binding People}" ItemTemplate="{StaticResource PersonCard}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemWidth="128" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding HasContacts}" Spacing="8">
                                <TextBlock Classes="h2" Text="Message someone" />
                                <ItemsControl ItemsSource="{Binding Contacts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChoiceItem">
                                            <Button Classes="chip" Content="{Binding Text}" Command="{Binding Command}" CommandParameter="{Binding Parameter}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Classes="h2" Text="Where to" />
                            <ItemsControl ItemsSource="{Binding Places}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemWidth="172" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlaceCardViewModel">
                                        <Button Classes="card" Command="{Binding Command}" CommandParameter="{Binding}">
                                            <StackPanel Spacing="4">
                                                <Panel Height="90" ClipToBounds="True">
                                                    <Border Classes="wait" />
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                    <ctl:Spinner Classes="spinner small"
                                                         IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" />
                                                </Panel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Classes="small" Text="{Binding TypeName}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- The ending offer: who to stay with. -->
                        <StackPanel IsVisible="{Binding IsEndingOffer}" Spacing="12">
                            <ItemsControl ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource Note}" />
                            <TextBlock Classes="lede" Text="{Binding Lede}" />
                            <ItemsControl ItemsSource="{Binding People}" ItemTemplate="{StaticResource PersonCard}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemWidth="128" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <!-- The ending, and what the player's choices did. -->
                        <StackPanel IsVisible="{Binding IsEnding}" Spacing="12">
                            <TextBlock Classes="story" Text="{Binding SceneText}" />

                            <TextBlock Classes="h2" Text="Who walked away" IsVisible="{Binding HasNotes}" />
                            <ItemsControl ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource Note}" />

                            <TextBlock Classes="h2" Text="Who you passed over"
                                       IsVisible="{Binding PassedOver, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Classes="lede" Text="{Binding PassedOver}"
                                       IsVisible="{Binding PassedOver, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <TextBlock Classes="h2" Text="Your choices" IsVisible="{Binding HasRecap}" />
                            <ItemsControl ItemsSource="{Binding Recap}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RecapItem">
                                        <StackPanel Spacing="2" Margin="0,0,0,10">
                                            <TextBlock Classes="small" Text="{Binding When}" />
                                            <TextBlock Text="{Binding Words}" TextWrapping="Wrap" />
                                            <TextBlock Classes="note" Text="{Binding Influence}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="h2" Text="{Binding ProfileOf}"
                                       IsVisible="{Binding ProfileOf, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <ItemsControl ItemsSource="{Binding Profile}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="sys:String">
                                        <TextBlock Classes="lede" Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Classes="accent" Content="Start another story" Command="{Binding HomeCommand}" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsNoOpening}" Spacing="12">
                            <TextBlock Classes="lede" Text="{Binding Lede}" />
                            <Button Classes="accent" Content="Choose an opening" Command="{Binding OpeningCommand}" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsOver}" Spacing="12">
                            <TextBlock Classes="lede" Text="{Binding Lede}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Overlays, above the person: back to the saves, the place's name, and the busy line. -->
        <Panel>
            <Button Classes="back" Content="‹" Command="{Binding HomeCommand}"
                    ToolTip.Tip="Saves" AutomationProperties.Name="Saves" />
            <Border Classes="caption" IsVisible="{Binding StageCaption, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StageCaption}" />
            </Border>
            <ProgressBar Classes="busy" IsIndeterminate="True" IsVisible="{Binding Working}" />

            <!-- The hidden debug screen, over everything. -->
            <Border Classes="debug" IsVisible="{Binding IsDebugOpen}">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,10">
                        <TextBlock Classes="title" Text="Debug" />
                        <Button Content="Refresh" Command="{Binding OpenDebugCommand}" />
                        <Button Content="Close" Command="{Binding CloseDebugCommand}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding DebugSections}" Margin="12,0,12,24">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="play:DebugSection">
                                    <Expander Header="{Binding Title}" IsExpanded="True" HorizontalAlignment="Stretch" Margin="0,0,0,6">
                                        <SelectableTextBlock Classes="debug"
                                                             Text="{Binding Lines, Converter={x:Static vm:DebugLines.Join}}" />
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Panel>
    </ctl:StageLayout>
</UserControl>
