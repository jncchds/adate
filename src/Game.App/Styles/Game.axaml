<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Pages that are forms or lists: one readable column. -->
    <Style Selector="StackPanel.page">
        <Setter Property="Margin" Value="20,16,20,32" />
        <Setter Property="Spacing" Value="10" />
        <Setter Property="MaxWidth" Value="760" />
    </Style>

    <Style Selector="StackPanel.side">
        <Setter Property="Margin" Value="16,12,16,28" />
        <Setter Property="Spacing" Value="12" />
    </Style>

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.lede">
        <Setter Property="Foreground" Value="#B8B8BC" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="#B8B8BC" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style Selector="TextBlock.small">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#9A9AA0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.note">
        <Setter Property="Foreground" Value="#D8CFA8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.story">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.reaction">
        <Setter Property="Foreground" Value="#E4DCF7" />
    </Style>

    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="#FF8A80" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Button.choice">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="Foreground" Value="#B8B8BC" />
    </Style>

    <!-- Picture cards: places, people and portraits. The chosen one is outlined. -->
    <Style Selector="Button.card">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Button.card.chosen /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="#E8C872" />
    </Style>

    <Style Selector="Border.wait">
        <Setter Property="Background" Value="#26262A" />
    </Style>

    <Style Selector="Panel.stage">
        <Setter Property="Background" Value="#101012" />
    </Style>

    <Style Selector="Border.caption">
        <Setter Property="Background" Value="#A0000000" />
        <Setter Property="CornerRadius" Value="0,0,8,0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style Selector="Border.popup">
        <Setter Property="Background" Value="#3A2F55" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="#1D1D1F" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style Selector="ProgressBar.busy">
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="MinHeight" Value="3" />
    </Style>
</Styles>
