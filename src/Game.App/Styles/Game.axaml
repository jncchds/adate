<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Game.App.Controls">

    <!-- Pages that are forms or lists: one readable column. -->
    <Style Selector="StackPanel.page">
        <Setter Property="Margin" Value="20,16,20,32" />
        <Setter Property="Spacing" Value="10" />
        <Setter Property="MaxWidth" Value="760" />
    </Style>

    <Style Selector="StackPanel.side">
        <Setter Property="Margin" Value="16,4,16,24" />
        <Setter Property="Spacing" Value="12" />
    </Style>

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.lede">
        <Setter Property="Foreground" Value="#B8B8BC" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="#B8B8BC" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style Selector="TextBlock.small">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#9A9AA0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.note">
        <Setter Property="Foreground" Value="#D8CFA8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.story">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.reaction">
        <Setter Property="Foreground" Value="#E4DCF7" />
    </Style>

    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="#FF8A80" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Button.choice">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="Foreground" Value="#B8B8BC" />
    </Style>

    <!-- Picture cards: places, people and portraits. The chosen one is outlined. -->
    <Style Selector="Button.card">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Button.card.chosen /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="#E8C872" />
    </Style>

    <Style Selector="Border.wait">
        <Setter Property="Background" Value="#26262A" />
    </Style>

    <Style Selector="Panel.stage">
        <Setter Property="Background" Value="#101012" />
    </Style>

    <!-- The place's name, top right: the back button has the top left. -->
    <Style Selector="Border.caption">
        <Setter Property="Background" Value="#A0000000" />
        <Setter Property="CornerRadius" Value="0,0,0,8" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- A small round back button in the screen's top left corner. -->
    <Style Selector="Button.back">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="10" />
        <Setter Property="Padding" Value="0,0,2,3" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="#A0000000" />
    </Style>

    <!-- The text box's header: the screen's title at the left, the name tag at the right. -->
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.popup">
        <Setter Property="Background" Value="#3A2F55" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="#1D1D1F" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- The words over the picture: dark enough to read on any background, light enough to see through. -->
    <Style Selector="Border.textbox">
        <Setter Property="Background" Value="#C8141418" />
        <Setter Property="BorderBrush" Value="#30FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- Stacked under the picture on an upright screen, the box is simply the lower part of the page. -->
    <Style Selector="ctl|StageLayout:stacked > Border.textbox">
        <Setter Property="Background" Value="#121213" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Border.nametag">
        <Setter Property="Background" Value="#E8C872" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.nametag > TextBlock">
        <Setter Property="Foreground" Value="#1A1A1A" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A turning arc wherever a picture or words are on their way. -->
    <Style Selector="Arc.spinner">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="StartAngle" Value="0" />
        <Setter Property="SweepAngle" Value="270" />
        <Setter Property="Stroke" Value="#E8C872" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Animations>
            <Animation Duration="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="RenderTransform" Value="rotate(0deg)" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RenderTransform" Value="rotate(360deg)" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Arc.spinner.small">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="StrokeThickness" Value="2.5" />
    </Style>

    <Style Selector="Border.loading">
        <Setter Property="Background" Value="#B0101012" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The player's own words inside the scene, before the reaction. -->
    <Style Selector="Border.reply">
        <Setter Property="Background" Value="#22E8C872" />
        <Setter Property="BorderBrush" Value="#E8C872" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style Selector="ProgressBar.busy">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="MinHeight" Value="3" />
    </Style>
</Styles>
