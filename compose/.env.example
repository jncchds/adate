# Copy to .env for secrets. Profiles in profiles/ carry everything else.
#
# Neither token is needed for the default model set: every entry in
# provision/models.tsv resolves from HuggingFace without an account.

# Only required for gated or private HuggingFace repos.
HF_TOKEN=

# Only required if you add a CivitAI-hosted model to provision/models.tsv.
CIVITAI_TOKEN=
