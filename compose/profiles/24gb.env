# 24GB+ VRAM profile -- development boxes and enthusiast hardware.
#
# Same style pack as the 12GB profile, deliberately. A pack is locked per save
# (HANDOFF 1.5), so a save created here must remain playable on a 12GB machine.
# The headroom buys a larger LLM and a longer context, not different art.
#
# Budget, approximate, at peak:
#   SD1.5 + IP-Adapter @ 768px    ~4.0 GB
#   Qwen3-8B Q4_K_M + 32k KV      ~8.0 GB
#   embeddings on GPU             ~0.2 GB
#   -------------------------------------
#   total                        ~12.2 GB of 24 GB
#
# If you want SDXL-family art, that is a second style pack rather than a setting
# here, and it will not be interchangeable with saves made under this one.

# Rolling tag. A dated tag (cu130-slim-YYYYMMDD) pins the stack instead, at the cost
# of not picking up ComfyUI updates; swap it in if a future upgrade breaks generation.
#
# cu130 is required here, not merely preferred. On an RTX 5090 the cu126 image
# starts and reports the device correctly, then fails every kernel launch with
# "no kernel image is available for execution on the device" -- its PyTorch has no
# sm_120 kernels compiled in. cu124 does not support Blackwell at all.
COMFY_IMAGE=yanwk/comfyui-boot:cu130-slim
COMFY_PORT=8188
COMFY_EXTRA_ARGS=

MODELS_PATH=./models
CUSTOM_NODES_PATH=./custom_nodes
OUTPUT_PATH=./output
INPUT_PATH=./input

LLM_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LLM_PORT=8080
LLM_HF_REPO=Qwen/Qwen3-8B-GGUF
LLM_HF_FILE=Qwen3-8B-Q4_K_M.gguf
LLM_CTX=32768
LLM_GPU_LAYERS=999
LLM_ALIAS=chat

EMBEDDINGS_PORT=8081
EMBEDDINGS_HF_REPO=nomic-ai/nomic-embed-text-v1.5-GGUF
EMBEDDINGS_HF_FILE=nomic-embed-text-v1.5.Q8_0.gguf
EMBEDDINGS_CTX=2048
EMBEDDINGS_GPU_LAYERS=999
EMBEDDINGS_ALIAS=embeddings

IPADAPTER_REF=main
