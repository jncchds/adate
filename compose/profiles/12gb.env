# 12GB VRAM profile -- the product target.
#
# Everything stays resident. No model is ever swapped, because swapping between the
# image model and the LLM would cost seconds on every turn that generates art.
#
# Budget at peak. File sizes are verified; VRAM figures are estimates until measured.
#   SD1.5 + IP-Adapter @ 768px    ~4.0 GB   (estimate)
#   Gemma 4 E4B QAT q4_0          ~5.2 GB   (verified file size)
#     + 8k KV cache               ~0.5 GB   (estimate)
#   embeddings                     0.0 GB   (on CPU, see below)
#   -------------------------------------
#   total                         ~9.7 GB of 12 GB
#
# This is why the image side stays SD1.5 here. Illustrious plus a ControlNet plus an
# IP-Adapter is roughly 12-14 GB on its own, which leaves nothing for a co-resident
# LLM on a 12 GB card. A 12 GB machine therefore gets the SD1.5 style pack, and since
# a pack is locked per save (HANDOFF 1.5), saves are not portable to the SDXL pack.

# Rolling tag. A dated tag (cu130-slim-YYYYMMDD) pins the stack instead, at the cost
# of not picking up ComfyUI updates; swap it in if a future upgrade breaks generation.
#
# NOT cu124: CUDA 12.4 predates Blackwell (sm_120) entirely.
# NOT cu126 either: on a Blackwell card it starts and reports the device happily,
# then fails every kernel launch with "no kernel image is available for execution
# on the device", because its PyTorch carries no sm_120 kernels. Verified on a 5090.
#
# The trade: CUDA 13 drops pre-Turing cards, so nothing below compute 7.5 runs this.
# Every GPU with 12GB worth targeting is Ampere or newer, so that costs us nothing.
COMFY_IMAGE=yanwk/comfyui-boot:cu130-slim
COMFY_PORT=8188
# Deliberately empty. Do NOT set --highvram here: it keeps every model resident,
# which is right on a 32GB card and an out-of-memory error on a 12GB one.
COMFY_EXTRA_ARGS=

# Bind mounts. Absolute host paths so weights are inspectable and shareable with a
# native ComfyUI or LM Studio install on the same box.
MODELS_PATH=./models
CUSTOM_NODES_PATH=./custom_nodes
OUTPUT_PATH=./output
INPUT_PATH=./input

LLM_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LLM_PORT=8080
LLM_HF_REPO=google/gemma-4-E4B-it-qat-q4_0-gguf
LLM_HF_FILE=gemma-4-E4B_q4_0-it.gguf
LLM_CTX=8192
LLM_GPU_LAYERS=999
LLM_ALIAS=chat

# Embeddings on CPU. The model is 146 MB and the memory system embeds a handful of
# short strings per turn, so the latency is irrelevant and the VRAM is not.
EMBEDDINGS_PORT=8081
EMBEDDINGS_HF_REPO=nomic-ai/nomic-embed-text-v1.5-GGUF
EMBEDDINGS_HF_FILE=nomic-embed-text-v1.5.Q8_0.gguf
EMBEDDINGS_CTX=2048
EMBEDDINGS_GPU_LAYERS=0
EMBEDDINGS_ALIAS=embeddings

# Pin the IP-Adapter node once a known-good commit is confirmed on real hardware.
# Left at main until then, because pinning to an unverified sha is worse than not
# pinning at all.
IPADAPTER_REF=main

# SD1.5 model set only. Illustrious plus a ControlNet plus an IP-Adapter does not
# leave room for a co-resident LLM on a 12GB card -- see docs/spike0-findings.md.
MANIFESTS=models-sd15.tsv
# Off, and this is a change: the guard on this was broken (a mangled variable
# reference made it always false), so the node has in fact never been installed.
# Fixing the guard would have installed it on the next recreate -- and we do not
# need it. Pose skeletons come from ComfyUI's own SDPoseKeypointExtractor and
# SDPoseDrawKeypoints. Set to 1 only if you want the preprocessors for your own
# use; it pip-installs its own requirements into the ComfyUI image.
INSTALL_CONTROLNET_AUX=0
